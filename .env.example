# Copy to .env and add your private Gemini API key. Never commit .env.
AI_PROVIDER=gemini
GEMINI_API_KEY=PUT_YOUR_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: a different model for the live "mystery shopper" (defaults to GEMINI_MODEL)
# GEMINI_SHOPPER_MODEL=gemini-3.5-flash
SHOPPER_LOCATION=Paterson, NJ
# Seconds between live API calls (free-tier rate limits)
LIVE_EVAL_DELAY=4
# Set to 0 to skip loading the Casa Coquí showcase on startup
PROOF_FLOWER_SEED=1

# Optional fallbacks
OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://127.0.0.1:11434
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
